#---- Generated by tint2conf 8caf ----
# See https://gitlab.com/o9000/tint2/wikis/Configure for 
# full documentation of the configuration options.
#-------------------------------------
# Gradients
#-------------------------------------
# Backgrounds
# Background 1: Panel
rounded = 0
border_width = 3
border_sides = T
border_content_tint_weight = 0
background_content_tint_weight = 0
background_color = #fdfdfd 100
border_color = #448aff 100
background_color_hover = #fdfdfd 100
border_color_hover = #448aff 100
background_color_pressed = #fdfdfd 100
border_color_pressed = #448aff 100

#-------------------------------------
# Panel
panel_items = EFSEEEEEE:E
panel_size = 100% 40
panel_margin = 0 0
panel_padding = 0 0 0
panel_background_id = 1
wm_menu = 0
panel_dock = 0
panel_pivot_struts = 0
panel_position = bottom center horizontal
panel_layer = normal
panel_monitor = all
panel_shrink = 0
autohide = 0
autohide_show_timeout = 0
autohide_hide_timeout = 0
autohide_height = 1
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 0
mouse_effects = 0
font_shadow = 0
mouse_hover_icon_asb = 100 0 10
mouse_pressed_icon_asb = 100 0 0
scale_relative_to_dpi = 0
scale_relative_to_screen_height = 0

#-------------------------------------
# System tray (notification area)
systray = 1
systray_padding = 8 8 8
systray_background_id = -1
systray_sort = left2right
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = primary
systray_name_filter = 

#-------------------------------------
# Clock
time1_format = %a, %d %b %y at %H:%M
time2_format = 
time1_font = SpaceMono Nerd Font Bold 10
time1_timezone = 
time2_timezone = 
clock_font_color = #448aff 100
clock_padding = 10 2
clock_background_id = 0
#clock_tooltip = %A, %d %B %Y
clock_tooltip_timezone = 
clock_lclick_command = 
clock_rclick_command = 
clock_mclick_command = 
clock_uwheel_command = 
clock_dwheel_command = 

#-------------------------------------
# Battery
#battery_tooltip = 1
battery_low_status = 0
battery_low_cmd = 
battery_full_cmd = 
bat1_font = SpaceMono Nerd Font Bold 10
battery_font_color = #448aff 100
bat1_format =   %p
bat2_format = 
battery_padding = 10 2
battery_background_id = -1
battery_hide = 0
battery_lclick_command =
battery_rclick_command = 
battery_mclick_command = 
battery_uwheel_command = 
battery_dwheel_command = 
ac_connected_cmd = 
ac_disconnected_cmd = 

#-------------------------------------
# Separator 1
separator = new
separator_background_id = -1
separator_color = #3584e4 100
separator_style = line
separator_size = 3
separator_padding = 10 10

#-------------------------------------
# Separator 2
separator = new
separator_background_id = -1
separator_color = #3584e4 100
separator_style = line
separator_size = 3
separator_padding = 10 10

#-------------------------------------
# Executor 1
# Workspaces executor have 2 modes: name and glyph.
# It is pretty easy to undertand that name mode would render the workspaces name, whereas glyph mode only render icon for each workspaces.
# As an aditional setting, glyph mode, activated by passing "glyph" argument after the script path in execp_command, is to change execp_continuous value to the amount of workspaces (e.g. 4) to render each workspaces per line.
#This is a workaround so that glyph mode would work properly in vertical bar.
execp = new
execp_command = ~/.config/tint2/workspaces.sh
execp_interval = 0
execp_has_icon = 0
execp_cache_icon = 1
execp_continuous = 1
execp_markup = 1
execp_monitor = all
execp_tooltip = 
execp_lclick_command = ~/.config/tint2/workspaces-click.sh
execp_rclick_command = 
execp_mclick_command = 
execp_uwheel_command = 
execp_dwheel_command = 
execp_font = GD-MadoMaruGothicJA-OTF 10
execp_font_color = #448aff 100
execp_padding = 5 2
execp_background_id = -1
execp_centered = 0
execp_icon_w = 0
execp_icon_h = 0

#-------------------------------------
# Executor 2
execp = new
execp_command = ~/.config/tint2/sound.sh
execp_lclick_command = pactl set-sink-mute @DEFAULT_SINK@ toggle
execp_markup = 1
execp_interval = 1
execp_continuous = 0
execp_tooltip =
execp_font = SpaceMono Nerd Font bold 10
execp_font_color =  #448aff 100
execp_padding = 10 2

