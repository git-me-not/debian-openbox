# ─────────────────────────────────────
# Background 1: white with blue top border
# ─────────────────────────────────────

rounded = 0
border_width = 3
border_sides = T
background_color = #FFFFFF 100
border_color = #448AFF 100


# ─────────────────────────────────────
# Panel
# ─────────────────────────────────────

panel_items = TFB:C
panel_position = bottom center horizontal
panel_size = 100% 37
panel_margin = 0 0
panel_padding = 0 0 0
panel_background_id = 1

# Test
execp = new
execp_command = echo test
execp_lclick_command = ~/justrunthis
#execp_continuous = 1
execp_markup = 1
execp_has_icon = 0
execp_font = SpaceMono Nerd Font bold 10
execp_font_color = #448AFF 100
execp_padding = 10 2
execp_tooltip = 0

# Workspaces
taskbar_mode = multi_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 12 9 8
taskbar_background_id = 0
taskbar_active_background_id = 1
taskbar_name = 1
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_hide_different_desktop = 0
taskbar_always_show_all_desktop_tasks = 0
taskbar_name_padding = 0 0
taskbar_name_background_id = 0
taskbar_name_active_background_id = 0
taskbar_name_font_color = #448AFF 100
taskbar_name_font = SpaceMono Nerd Font Bold 10
taskbar_name_active_font_color = #448AFF 100
taskbar_distribute_size = 1
taskbar_sort_order = center
task_align = right

# Task
task_text = 0
task_icon = 0
task_centered = 0
urgent_nb_of_blink = 0
task_maximum_size = 13 0
task_padding = 0 0 0
task_tooltip = 1
task_thumbnail = 0
task_thumbnail_size = 50
task_icon_asb = 0 0 0
task_background_id = 3
task_active_background_id = 2
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = next_task
mouse_scroll_down = none

# Battery
bat1_format =   %p
bat1_font = SpaceMono Nerd Font bold 12
battery_font_color = #448AFF 100
battery_padding = 10 2

# Separator 1
separator = new
separator_color = #3584e4 100
separator_style = line
separator_size = 3
separator_padding = 10 10

# ─────────────────────────────────────
# Clock
# ─────────────────────────────────────

time1_format = %H:%M
time1_font = SpaceMono Nerd Font bold 10
clock_font_color = #448AFF 100
clock_padding = 10 2
clock_background_id = 0
clock_tooltip = %A, %d %B %Y
