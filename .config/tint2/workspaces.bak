#!/bin/sh

xprop -root -spy \
    _NET_CURRENT_DESKTOP \
    _NET_NUMBER_OF_DESKTOPS \
    _NET_DESKTOP_NAMES |
awk '
function render(    i, n, name, out) {
    if (count < 1 || names == "")
        return

    n = split(names, ws, /",[[:space:]]*"/)

    ws[1] = substr(ws[1], 2)
    ws[n] = substr(ws[n], 1, length(ws[n]) - 1)

    out = ""

    for (i = 1; i <= count; i++) {
        name = ws[i]

        if (i - 1 == current)
            out = out "<span foreground=\"#448AFF\"> " name "</span>"  "<span foreground=\"#448AFF\"> ★ </span>"
        else
            out = out "<span foreground=\"#000000\"> " name "</span>"  "<span foreground=\"#FDFDFD\"> ★ </span>"

        if (i < count)
            out = out "  "
    }

    print out
    fflush()
}

/^_NET_CURRENT_DESKTOP/ {
    value = $0
    sub(/^.*= /, "", value)
    current = value + 0
    render()
    next
}

/^_NET_NUMBER_OF_DESKTOPS/ {
    value = $0
    sub(/^.*= /, "", value)
    count = value + 0
    next
}

/^_NET_DESKTOP_NAMES/ {
    value = $0
    sub(/^.*= /, "", value)
    names = value
    render()
    next
}
'
