#-------------------------------------
# Background
#-------------------------------------

rounded = 0
border_width = 0
background_color = #FFFFFF 100
border_color = #FFFFFF 0

#-------------------------------------
# Panel
#-------------------------------------

panel_items = T
panel_position = bottom center horizontal
panel_size = 100% 37
panel_margin = 0 0
panel_padding = 0 0 0
panel_background_id = 1

#-------------------------------------
# Workspace / Taskbar
#-------------------------------------

taskbar_mode = multi_desktop
taskbar_hide_if_empty = 0
taskbar_hide_different_desktop = 1
taskbar_hide_inactive_tasks = 1
taskbar_hide_active_task = 1
taskbar_padding = 10 0 10
taskbar_background_id = 1
taskbar_active_background_id = 1

taskbar_name = 1
taskbar_name_padding = 8 2

taskbar_name_background_id = 1
taskbar_name_active_background_id = 1

taskbar_name_font = SpaceMono Nerd Font bold 10
taskbar_name_font_color = #448AFF 100
taskbar_name_active_font_color = #448AFF 100

taskbar_distribute_size = 1
taskbar_sort_order = center

