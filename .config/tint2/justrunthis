#!/bin/sh

xprop -root -spy \
    _NET_NUMBER_OF_DESKTOPS \
    _NET_CURRENT_DESKTOP \
    _NET_DESKTOP_NAMES |
awk '
BEGIN {
    count = 0
    current = 0
    names = ""
}

function render(    i, name, sep, n) {
    if (count < 1 || names == "")
        return

    n = split(names, ws, /",[[:space:]]*"/)

    # Remove quotes left by xprop.
    ws[1] = substr(ws[1], 2)
    ws[n] = substr(ws[n], 1, length(ws[n]) - 1)

    output = ""

    for (i = 1; i <= count; i++) {
        name = ws[i]

        if (i - 1 == current)
            output = output "<span foreground=\"#448AFF\">● " name "</span>"
        else
            output = output "<span foreground=\"#000000\">○ " name "</span>"

        if (i < count)
            output = output "   "
    }

    print output
    fflush()
}

/^_NET_NUMBER_OF_DESKTOPS/ {
    value = $0
    sub(/^.*= /, "", value)
    count = value + 0
    next
}

/^_NET_CURRENT_DESKTOP/ {
    value = $0
    sub(/^.*= /, "", value)
    current = value + 0
    render()
    next
}

/^_NET_DESKTOP_NAMES/ {
    value = $0
    sub(/^.*= /, "", value)
    names = value
    render()
    next
}
'
